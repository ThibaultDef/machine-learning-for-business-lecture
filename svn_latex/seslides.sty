\newcommand{\se@frame}{\makebox[0pt][l]
{\kern\se@left\raisebox{\se@bot}[0pt][0pt]{%
\setlength{\unitlength}{1pt}%
\tue@logo%
\rule{\SErulewidth}{\se@height}%
\rule[\se@height]{\se@width}{\SErulewidth}%
\rule{\SErulewidth}{\se@height}%
\se@logo}}}

\newcommand{\se@pagenum}[1]{\makebox[0pt][l]
 {\kern\se@left\raisebox{\se@bot}[0pt][0pt]
 {\kern35pt#1\kern20pt{\tiny\SEslide@mark}}}}

\def\ps@headings{%
  \def\ps@slide{%
    \def\@oddfoot{\@mainsize \se@frame\se@pagenum{\theslide}\hfil}%
    \def\@oddhead{}%
    \def\@evenfoot{\@mainsize \se@frame\se@pagenum{\theslide}\hfil}%
    \def\@evenhead{}}

  \def\ps@overlay{%
    \def\@oddfoot{\@mainsize \se@pagenum{\theoverlay}\hfil}%
    \def\@oddhead{}%
    \def\@evenfoot{\@mainsize \se@pagenum{\theoverlay}\hfil}%
    \def\@evenhead{}}

  \def\ps@note{%
    \def\@oddfoot{%
      \@mainsize
      \se@pagenum{\thenote}\hfil
      \if@clock \fbox{\large \arabic{minutes} min}\else \hbox{}\fi}%
    \def\@oddhead{}%
    \def\@evenfoot{%
      \@mainsize
      \se@pagenum{\thenote}\hfil
      \if@clock \fbox{\large \arabic{minutes} min}\else \hbox{}\fi}%
    \def\@evenhead{}}}

\pagestyle{headings}
\SEframesep{0.5in}

