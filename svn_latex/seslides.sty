\newcommand{\SEframesep}[1]{\setlength{\se@margin}{#1}\se@recalc}
\newlength{\SErulewidth} \setlength{\SErulewidth}{0.7pt}
\newcommand{\SEslide@mark}{}
\newcommand{\SEslidemark}[1]{\def\SEslide@mark{#1}}

\setlength\footskip{96\p@}

\newcommand{\se@recalc}{%
\if@compatibility
  \setlength\textwidth{460\p@}
\else
  \setlength\@tempdima{\paperwidth}
  \addtolength\@tempdima{-2\se@margin}
  \addtolength\@tempdima{-1in}
  \setbox\@tempboxa\hbox{\rmfamily im}
  \setlength\@tempdimb{.5\wd\@tempboxa}
  \setlength\@tempdimb{90\@tempdimb}
  \ifdim\@tempdima>\@tempdimb\relax
    \setlength\textwidth{\@tempdimb}
  \else
    \setlength\textwidth{\@tempdima}
  \fi
\fi

\@settopoint\textwidth
\columnwidth \textwidth
\columnsep 10pt
\columnseprule \z@

\if@compatibility
  \setlength\textheight{600\p@}
\else
  \setlength\@tempdima{\paperheight}
  \addtolength\@tempdima{-2\se@margin}
  \addtolength\@tempdima{-1in}
  \addtolength\@tempdima{-\headheight}
  \addtolength\@tempdima{-\headsep}
  \addtolength\@tempdima{-\footskip}
  \divide\@tempdima\baselineskip
  \@tempcnta=\@tempdima
  \setlength\textheight{\@tempcnta\baselineskip}
\fi
\advance\textheight by \topskip

\if@compatibility
   \setlength\oddsidemargin  {17\p@}
   \setlength\evensidemargin {17\p@}
   \setlength\marginparwidth {20\p@}
\else
  \setlength\@tempdima        {\paperwidth}
  \addtolength\@tempdima      {-2in}
  \addtolength\@tempdima      {-\textwidth}
  \setlength\oddsidemargin    {.5\@tempdima}
  \setlength\marginparwidth   {.8in}
  \addtolength\marginparwidth {.5\@tempdima}
  \setlength\evensidemargin  {\paperwidth}
  \addtolength\evensidemargin{-2in}
  \addtolength\evensidemargin{-\textwidth}
  \addtolength\evensidemargin{-\oddsidemargin}
\fi

\setlength\marginparsep {5\p@}
\setlength\marginparpush{5\p@}

\if@compatibility
  \setlength\topmargin{-10pt}
\else
  \setlength\topmargin{\paperheight}
  \addtolength\topmargin{-2in}
  \addtolength\topmargin{-\headheight}
  \addtolength\topmargin{-\headsep}
  \addtolength\topmargin{-\textheight}
  \addtolength\topmargin{-\footskip}
  \addtolength\topmargin{-.5\topmargin}
\fi
\@settopoint\topmargin

\setlength{\se@left}{-\oddsidemargin}
\addtolength{\se@left}{-1in}
\addtolength{\se@left}{\se@margin}
\setlength{\se@bot}{\topmargin}
\addtolength{\se@bot}{\headheight}
\addtolength{\se@bot}{\headsep}
\addtolength{\se@bot}{\textheight}
\addtolength{\se@bot}{\footskip}
\addtolength{\se@bot}{1in}
\addtolength{\se@bot}{-\paperheight}
\addtolength{\se@bot}{\se@margin}
\setlength{\se@height}{\paperheight}
\addtolength{\se@height}{-2\se@margin}
\setlength{\se@width}{\paperwidth}
\addtolength{\se@width}{-2\se@margin}
} % end of command \se@recalc

