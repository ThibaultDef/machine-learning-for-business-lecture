\def\reportnr#1{\gdef\@reportnr{#1}}
\def\institute#1{\gdef\@institute{#1}}
\def\coaching#1{\gdef\@coaching{#1}}
\def\reportline#1{\gdef\@reportline{#1}}
\def\dateline#1{\gdef\@dateline{#1}}

\def\frontpage{
\begin{titlepage}
  \fontsize{12}{14.5}\selectfont
  \let\footnotesize\small \let\footnoterule\relax \setcounter{page}{1}
  \noindent
  \null
  \vfil
  \vskip 8mm
  {\raggedright\leftskip 47mm
    \vbox to 59mm{
    \vspace{\stretch{1.2}}
    {\large \@title \\}
    \vspace{\stretch{1}}
    \@author\\
    \vspace{\stretch{1}}
    \@reportnr\\
    \vspace{\stretch{1.2}}}}
  \vfill
  \@reportline\par\vskip 7mm
  \begin{tabular}{@{}l@{ }l}\@coaching\end{tabular}\par\vskip 3.5mm
  \textsc{\@institute}\par\vskip 7mm
  \@dateline\par
  \vfil
  \null
\end{titlepage}

\setcounter{footnote}{0}
\let\frontpage\relax}


