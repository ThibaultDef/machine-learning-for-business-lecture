\begin{Verbatim}[commandchars=\\\{\}]
\PYG{n}{wages} \PYG{o}{=} \PYG{n}{df}\PYG{p}{[}\PYG{l+s+s2}{\PYGZdq{}wage\PYGZdq{}}\PYG{p}{]}

\PYG{n}{n} \PYG{o}{=} \PYG{n+nb}{len}\PYG{p}{(}\PYG{n}{wages}\PYG{p}{)}
\PYG{n}{mean\PYGZus{}wage} \PYG{o}{=} \PYG{n}{wages}\PYG{o}{.}\PYG{n}{mean}\PYG{p}{()}
